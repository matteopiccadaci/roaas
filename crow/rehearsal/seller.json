{
  "template": "template.json",
  "scope": {
    "task": {
      "type": "string",
      "pattern": "^(joint_waypoints|repeatability)$"
    },
    "orderText": {
      "type": "string",
      "pattern": "^\\{[\\s\\S]{20,3000}\\}\\s*$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "orderSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "sellerApi": {
    "baseUrl": "https://PLACEHOLDER.vercel.app/",
    "auth": {
      "env": "ROAAS_JOB_API_KEY",
      "header": "X-ROaaS-Key"
    },
    "quote": "https://PLACEHOLDER.vercel.app/api/crow/quote",
    "start": "https://PLACEHOLDER.vercel.app/api/crow/jobs",
    "result": "https://PLACEHOLDER.vercel.app/api/crow/jobs/{jobId}/result"
  },
  "quoteRateLimit": {
    "overall": {
      "requests": 30,
      "windowSec": 60
    }
  },
  "signingKey": "standing",
  "payoutAddress": "PLACEHOLDER",
  "timing": {
    "offerExpiresInSec": 3600,
    "fundWithinSec": 7200,
    "deliverWithinSec": 259200,
    "judgeWithinSec": 600,
    "fallbackWithinSec": 600,
    "appealWindowSec": 0,
    "appealDecideSec": 600
  },
  "pollMs": 3000,
  "redelivery": {
    "refetchEverySec": 60
  }
}
